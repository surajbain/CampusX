# ---- App ----
APP_NAME=CampusX
APP_ENV=development

# ---- HTTP ----
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=campusx
DB_PASSWORD=campusx_dev_password
DB_NAME=campusx
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT (min 32 chars each, must differ) ----
JWT_ACCESS_SECRET=change_me_dev_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=campusx

# ---- Security ----
QR_HMAC_SECRET=change_me_dev_qr_hmac_secret_min_32_chars_long

# ---- Migrations ----
RUN_MIGRATIONS=true